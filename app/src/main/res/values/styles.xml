<resources>
    <style name="Theme.Jot" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorAccent">@color/jot_accent</item>
    </style>
    <color name="window_background">#F3F3F6</color>
    <color name="jot_accent">#815700</color>
    <color name="launcher_background">#FFCB4F</color>
    <bool name="light_status_bar">true</bool>
</resources>
